# Fanoos production settings.
# Preferred: enter these in cPanel -> Setup Python App -> your app -> "Environment variables".
# Alternative: copy this file to ".env" in the application root (never inside public_html).
# NEVER put a real key in JavaScript, HTML, or any file under public_html.

# --- AI provider: set ONE key (or more; see FANOOS_PROVIDER) ---
# xAI Grok (paid; live web + X search)      https://console.x.ai
XAI_API_KEY=
# Google Gemini (free tier with limits)      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier with limits)               https://console.groq.com/keys
GROQ_API_KEY=

# Which provider to use: xai | gemini | groq.
# Empty = the first key present, in the order xai, gemini, groq.
FANOOS_PROVIDER=
# Optional model override (empty = the provider's default)
FANOOS_MODEL=

# --- Server (safe defaults; change only if needed) ---
# production disables /docs. Keep production on a public site.
FANOOS_ENV=production
# Reviews allowed per visitor IP: N/second|minute|hour|day, or 0 to disable
FANOOS_RATE_LIMIT=10/hour
# Reviews processed at the same time (keep low on shared hosting)
FANOOS_MAX_CONCURRENT=2
# Seconds to wait for the AI provider
FANOOS_TIMEOUT=180
# Largest PDF upload in MB
FANOOS_MAX_UPLOAD_MB=15
# 1 only if a reverse proxy in front of Passenger sets X-Forwarded-For / X-Forwarded-Proto
FANOOS_TRUST_PROXY=0
# DEBUG | INFO | WARNING | ERROR
FANOOS_LOG_LEVEL=INFO
