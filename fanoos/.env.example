# Copy to .env and fill in at least one key. .env is git-ignored.
# Selection: FANOOS_PROVIDER if set, else the first key present (xai, gemini, groq).

# xAI Grok (paid, includes live web + X search) — https://console.x.ai
XAI_API_KEY=
# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Optional
# FANOOS_PROVIDER=gemini
# FANOOS_MODEL=gemini-flash-latest
